<?php

declare(strict_types=1);

/**
 * @file
 * Habillage AVEREO des ecrans publics d'identification.
 */

/**
 * Implements hook_page_attachments().
 */
function avereo_identity_bridge_page_attachments(array &$attachments): void
{
    $routeName = \Drupal::routeMatch()->getRouteName();
    if (in_array($routeName, [
        'user.login',
        'user.register',
        'user.pass',
        'user.reset',
        'user.reset.login',
        'avereo_identity_bridge.account_password',
        'avereo_identity_bridge.account_ready',
    ], true)) {
        $attachments['#attached']['library'][] = 'avereo_identity_bridge/identity';
    }
}

/**
 * Implements hook_mail().
 */
function avereo_identity_bridge_mail(string $key, array &$message, array $params): void
{
    if ($key !== 'account_activation') {
        return;
    }

    $displayName = trim((string) ($params['display_name'] ?? ''));
    $activationLink = (string) ($params['activation_link'] ?? '');
    $requiresPasswordInitialization = ($params['requires_password_initialization'] ?? false) === true;
    $supportEmail = (string) ($params['support_email'] ?? 'contact@avereo.fr');
    $message['subject'] = 'Votre invitation à AVEREO CONNECT';
    avereo_identity_bridge_set_reply_to($message, $supportEmail);
    $action = $requiresPasswordInitialization
        ? "Pour définir votre premier mot de passe, utilisez ce lien personnel à usage unique :"
        : "Votre mot de passe choisi lors de l’inscription reste inchangé. "
            . "Pour confirmer votre accès, utilisez ce lien personnel à usage unique :";
    $message['body'][] = ($displayName === '' ? 'Bonjour,' : 'Bonjour ' . $displayName . ',')
        . "\n\nVous êtes invité à accéder à AVEREO CONNECT."
        . "\n\n" . $action
        . "\n" . $activationLink
        . "\n\nCe lien expire après 24 heures. Vous pourrez ensuite vous connecter avec cette adresse e-mail."
        . "\n\nSi vous n’êtes pas à l’origine de cette demande ou si vous avez besoin d’aide,"
        . "\ncontactez l’administrateur : " . $supportEmail
        . "\n\nL’équipe AVEREO";
}

/**
 * Implements hook_mail_alter().
 */
function avereo_identity_bridge_mail_alter(array &$message): void
{
    if (($message['module'] ?? null) !== 'user') {
        return;
    }
    if (($message['key'] ?? null) === 'status_activated'
        && \Drupal\avereo_identity_bridge\Controller\AccountActivationController::sendsOwnActivationMailFor(
            $message['params']['account'] ?? null,
        )) {
        $message['send'] = false;
        return;
    }
    $configuration = \Drupal\Core\Site\Settings::get('avereo_identity_bridge', []);
    $path = \Drupal\Core\Site\Settings::get(
        'avereo_identity_bridge_config_path',
        dirname(DRUPAL_ROOT) . '/private/avereo-identity-bridge.php',
    );
    if (is_string($path) && is_readable($path)) {
        $fileConfiguration = require $path;
        if (is_array($fileConfiguration)) {
            $configuration = $fileConfiguration;
        }
    }
    $supportEmail = is_array($configuration)
        ? trim((string) ($configuration['support_email'] ?? 'contact@avereo.fr'))
        : 'contact@avereo.fr';
    if (filter_var($supportEmail, FILTER_VALIDATE_EMAIL) === false) {
        $supportEmail = 'contact@avereo.fr';
    }
    avereo_identity_bridge_set_reply_to($message, $supportEmail);
    $message['body'][] = "\nBesoin d’aide ? Contactez l’administrateur AVEREO : " . $supportEmail;
}

/** Replace case-insensitive Reply-To headers; Symfony requires one unique value. */
function avereo_identity_bridge_set_reply_to(array &$message, string $email): void
{
    foreach (array_keys($message['headers'] ?? []) as $name) {
        if (strcasecmp((string) $name, 'Reply-To') === 0) {
            unset($message['headers'][$name]);
        }
    }
    $message['headers']['Reply-To'] = $email;
}

/** Implements hook_form_FORM_ID_alter() for the native login form only. */
function avereo_identity_bridge_form_user_login_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void
{
    $form['name']['#title'] = t('Identifiant ou adresse e-mail');
    $form['name']['#maxlength'] = 254;
    $form['#validate'] = array_merge(
        ['avereo_identity_bridge_login_identifier_validate'],
        $form['#validate'] ?? [],
    );
}

/** Normalizes the identifier before unchanged native credential/flood checks. */
function avereo_identity_bridge_login_identifier_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void
{
    $identifier = $form_state->getValue('name');
    $resolver = new \Drupal\avereo_identity_bridge\Authentication\LoginIdentifierResolver(
        \Drupal::entityTypeManager()->getStorage('user'),
    );
    $name = is_string($identifier) ? $resolver->resolve($identifier) : null;
    if ($name === null) {
        // An ambiguous email must not authenticate whichever username happens
        // to match it. Do not reveal the conflicting accounts to the caller.
        $form_state->setValue('name', '');
        $form_state->setErrorByName('name', t('Identifiant ou mot de passe non reconnu.'));
        return;
    }
    $form_state->setValue('name', $name);
}
