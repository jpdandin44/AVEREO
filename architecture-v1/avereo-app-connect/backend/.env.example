APP_ENV=production
APP_DEBUG=false
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=CHANGE_ME;charset=utf8mb4
DB_USER=CHANGE_ME
DB_PASSWORD=
SESSION_COOKIE_NAME=AVEREO_CONNECT_SESSION
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
TRUST_PROXY_HEADERS=false
OAUTH_ISSUER=https://idp.example/
OAUTH_AUTHORIZE_URL=https://idp.example/oauth/authorize
OAUTH_TOKEN_URL=https://idp.example/oauth/token
OAUTH_USERINFO_URL=https://idp.example/oauth/userinfo
OAUTH_CLIENT_ID=CHANGE_ME
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://connect.example/api/v1/auth/callback
OAUTH_SUCCESS_URL=/
OAUTH_SCOPES=openid profile email
OAUTH_PUBLIC_KEY_PATH=/home/CPANEL_USER/private/oauth/production/public.key
OAUTH_TRANSACTION_DIRECTORY=/home/CPANEL_USER/private/connect-production/oauth-transactions
APP_LAUNCH_RAPPORT_URL=https://rapport.example/connect/entry.php
APP_LAUNCH_RAPPORT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_LAUNCH_COUPE_URL=https://coupe.example/connect/entry.php
APP_LAUNCH_COUPE_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_LAUNCH_PROJET_URL=https://projet.example/connect/entry.php
APP_LAUNCH_PROJET_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_LAUNCH_THERMO_URL=https://thermo.example/connect/entry.php
APP_LAUNCH_THERMO_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_LAUNCH_DRONE_URL=https://drone.example/connect/entry.php
APP_LAUNCH_DRONE_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_LAUNCH_TTL_SECONDS=90
